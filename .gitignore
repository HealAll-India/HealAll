# ============================================================
# HealAll — root .gitignore
# Per-area ignores live in backend/.gitignore and frontend/.gitignore
# ============================================================

# Secrets — never commit
.env
.env.*
!.env.example

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

# Node (root-level tooling only; frontend has its own)
node_modules/
package-lock.json
package.json

# Generated
graphify-out/
backend/graphify-out/

# Claude Code / agent tooling — local state only
.claude/worktrees/
.claude/settings.local.json
.claude-flow/
.swarm/
.superpowers/

# IDEs / editors
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Local plans / drafts (keep out of repo unless explicitly added)
/plans/
plans/

# Agent-local working docs (per-clone state, never committed)
HANDOFF.md
docs/
COMPLETION_SUMMARY.md
IMPLEMENTATION_STATUS.md
.codex/
mythoughts/
AGENTS.md
