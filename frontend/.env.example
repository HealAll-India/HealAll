NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Android app (Trusted Web Activity) links file at /.well-known/assetlinks.json.
# Comma-separated SHA-256 fingerprints: the upload key AND the Play App Signing key
# (Play Console > App integrity > App signing). Unset = the file returns 404.
ANDROID_SHA256_CERT_FINGERPRINTS=
ANDROID_PACKAGE_NAME=com.healallindia.app
