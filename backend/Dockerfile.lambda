# API image for AWS Lambda (infra/aws/api/). The local/dev image is ./Dockerfile.
#
# The Lambda Web Adapter extension turns Lambda invocations into plain HTTP
# requests to uvicorn, so the FastAPI app runs unchanged. Differences from
# ./Dockerfile: no dev dependencies or compilers (smaller image, faster cold
# start) and no migrations at start-up (they would run on every cold start,
# racing each other); infra/aws/api/deploy.sh runs them once per deploy.

# Builder: resolve and install the runtime dependencies into a virtualenv.
FROM python:3.12-slim AS builder
WORKDIR /build
RUN python -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY pyproject.toml ./
COPY app ./app
RUN pip install --no-cache-dir .

# Runtime: the virtualenv, the adapter and the code. Lambda runs the container
# as its own non-root user and does its own health checking (the adapter's
# readiness probe on /health), so neither USER nor HEALTHCHECK applies here.
FROM python:3.12-slim
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:1.0.0 /lambda-adapter /opt/extensions/lambda-adapter
COPY --from=builder /opt/venv /opt/venv

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080 \
    AWS_LWA_READINESS_CHECK_PATH=/health \
    AWS_LWA_ASYNC_INIT=true

WORKDIR /app
COPY . .

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
