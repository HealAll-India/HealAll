# Settings for ./deploy.sh and ./put-secrets.sh. Copy to .env.prod (gitignored,
# never commit it) and fill in. Wrap any value containing & ? $ or spaces in
# single quotes. Secrets go to Secrets Manager via put-secrets.sh; deploy.sh
# itself only uses DATABASE_URL and the two app keys, to run migrations.

# Two different random strings, e.g. from:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
JWT_SECRET_KEY=

# Neon: the same connection string the Railway service used, quoted, e.g.
# 'postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require'
DATABASE_URL=

# Upstash: rediss://default:<password>@<host>:6379. Required: the app connects at
# start-up, and Google sign-in keeps its one-time nonces there.
REDIS_URL=

# S3 needs no keys here: the function uses its own IAM role.

# Required: without it OTP emails are written to the log instead of sent.
RESEND_API_KEY=

# Optional
MSG91_API_KEY=
MSG91_TEMPLATE_ID_OTP=
GOOGLE_CLIENT_ID=
# Extra CORS origins as a regex, e.g. Vercel previews. Leave empty for none.
APP_ALLOWED_ORIGIN_REGEX=
SENTRY_DSN=
AI_TRIAGE_ENABLED=false
GROQ_API_KEY=
GEMINI_API_KEY=
# Web push notifications: off until both are set. Generate the pair once, e.g.
# `npx web-push generate-vapid-keys`; changing it later drops every subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Bearer token Prometheus sends to read /metrics. Empty: /metrics answers 404.
METRICS_TOKEN=
# Random string Cloudflare sends as the X-Origin-Verify header (a Transform
# Rule on the api hostname). When set, requests without it get 403, so nobody
# can skip Cloudflare. Add the Cloudflare rule first, then set this.
ORIGIN_VERIFY_SECRET=
